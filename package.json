{
  "name": "workstudio-plugin-registry",
  "private": true,
  "version": "0.1.0",
  "description": "WorkStudio plugin registry",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:artifacts": "node scripts/validate.mjs --verify-artifacts",
